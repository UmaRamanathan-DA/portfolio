# Leave as-is to run in demo mode (browse + cart, no checkout).
# Replace with your Neon or Supabase connection string for full ecommerce:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# App URL (Vercel production URL or http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend — https://resend.com/api-keys
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Ksara Decor <orders@yourdomain.com>"

# Where corporate/event gifting inquiries (from /gifting) get emailed.
# Without this + RESEND_API_KEY, inquiries are only logged to the server console.
GIFTING_NOTIFY_EMAIL="you@yourdomain.com"

# Session security (generate a random string for production)
SECRET_KEY="change-me-in-production"
